        "mean_length": 244.59,
        "timeout_count": 9
      },
      "screening_rule": {
        "id": "double-dqn-seed42-manual-screen",
        "automatic_followup": false,
        "description": "Support for later replication requires a material mean-reward or solved-rate improvement without a material reduction in the other primary metric.",
        "combined_constraints": {
          "max_low_score_count": 1,
          "max_timeout_count": 9,
          "max_mean_length": 269.0
        },
        "manual_criteria": [
          "No several-hundred-step side-engine streak pathology.",
          "Improvement must be visible in both Benchmark A and Benchmark B rather than only one set."
